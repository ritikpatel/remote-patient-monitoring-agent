# --- Raw data: never enters git (PhysioNet DUA — see docs/DATA_USE.md) ---
/mimic-iv-clinical-database-demo-2.2/
/wearable-device-dataset-from-induced-stress-and-structured-exercise-sessions-1.0.1/
data/raw/
data/interim/*
data/processed/*
!data/interim/.gitkeep
!data/processed/.gitkeep
*.csv.gz
*.parquet
*.db

# EDA outputs are regenerated by the notebook, not hand-authored
eda_outputs/

# Generated PDFs (reports/run_reports.py) are regenerable demo output, not
# hand-authored -- same reasoning as eda_outputs/ above.
reports/output/*
!reports/output/.gitkeep

# Phase 7 evaluation outputs (eval/run_eval.py) are regenerable -- same
# reasoning as reports/output/ above.
eval/output/*
!eval/output/.gitkeep

# --- Python ---
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# --- Notebooks ---
.ipynb_checkpoints/

# --- MLflow / DVC ---
mlruns/
mlartifacts/
/mlruns.db
/dvc.lock.tmp
.dvc/cache
.dvc/tmp

# Phase 5's promoted model is an MLflow registry artefact, not a pickle
# committed to git ("the promoted model is a registry artefact, not a pickle
# in a folder" -- PROJECT_PLAN.md section 11). Regenerate with
# `python ml/evaluation/run_all.py`. risk-engine's /score/ml degrades to a
# real 503 when this is absent, rather than fabricating a prediction.
ml/models/promoted/*
!ml/models/promoted/.gitkeep

# --- Infra / secrets ---
.env
.env.*
*.pem
*.key
kubeconfig*

# --- Android / Gradle (edge/wear_os) ---
# gradlew, gradlew.bat and gradle/wrapper/gradle-wrapper.jar ARE committed (standard
# practice) so the project builds without a pre-installed Gradle. Everything below is
# machine-specific or regenerable.
edge/wear_os/local.properties
edge/wear_os/**/build/
edge/wear_os/.gradle/
edge/wear_os/**/.cxx/
edge/wear_os/captures/
*.apk
*.ap_

# --- Node / UI (ui/) ---
# package.json and package-lock.json ARE committed (standard practice, same
# reasoning as the Gradle wrapper above) so `npm install` reproduces the
# exact dependency tree; node_modules/ and build output are regenerable.
ui/node_modules/
ui/dist/
ui/.vite/
npm-debug.log*

# --- OS / editor ---
.DS_Store
.idea/
.vscode/

# Shareable data exports (patient-derived rows -- never into git, per docs/DATA_USE.md).
# Regenerate with the scripts referenced in each workbook README sheet.
exports/
